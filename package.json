{
  "name": "moment-captured-portfolio",
  "version": "2.0.0",
  "description": "Fine Art & Cinematic Photography Studio Portfolio for Moment Captured",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "npx serve -l 3000 .",
    "healthcheck": "node -e \"require('http').get('http://localhost:' + (process.env.PORT || 3000) + '/api/health', (r) => { if (r.statusCode === 200) process.exit(0); else process.exit(1); })\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "photography",
    "portfolio",
    "moment-captured",
    "cinematic",
    "canvas-scroll",
    "fine-art"
  ],
  "author": "Moment Captured",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
