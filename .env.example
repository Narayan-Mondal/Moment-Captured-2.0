# ==============================================================================
# Moment Captured - Cloudinary & Studio Environment Configuration Template
# Copy this file to .env and fill in your actual Cloudinary API credentials
# ==============================================================================

# Cloudinary Credentials (Get these from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Cloudinary Upload Preset (Optional for unsigned direct client uploads)
CLOUDINARY_UPLOAD_PRESET=moment_captured_stories

# Admin Dashboard Password (Default password for /admin.html)
ADMIN_PASSWORD=momentcaptured2026

# Server Port
PORT=3000
